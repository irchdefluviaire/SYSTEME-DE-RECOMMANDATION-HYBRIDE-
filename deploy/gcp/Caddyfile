:80 {
    encode zstd gzip

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:8000
    }

    handle /docs* {
        reverse_proxy api:8000
    }

    handle /redoc* {
        reverse_proxy api:8000
    }

    handle /openapi.json {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy ui:8501
    }
}
