# Copiez ce fichier vers .env et remplacez toutes les valeurs CHANGE_ME.
# Ne versionnez jamais .env.
PG_HOST=postgres
PG_PORT=5432
PG_DB=kmer_ai
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_POSTGRES

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J
NEO4J_DATABASE=neo4j

MODEL_PATH=/app/models/st_finetuned/final
AGENT_USE_REAL_DBS=1
TEXT2CYPHER_DISABLE_HF=1

API_KEY_OPEN_ROUTEUR=CHANGE_ME_OPENROUTER
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Facultatif : desactivez en demonstration si vous n'utilisez pas LangSmith.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
